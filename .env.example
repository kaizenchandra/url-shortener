# Local development: replace both values with randomly generated passwords.
DATABASE_PASSWORD=replace-with-local-random-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-random-admin-password

# Separate host ports allow this stack to run alongside rate-limiter.
APP_PORT=8081
KEYCLOAK_PORT=9001
POSTGRES_PORT=5433
REDIS_PORT=6380
